PORT=3001
MONGODB_URI=mongodb://admin:password123@localhost:27777/gerifinancial?authSource=admin
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
NODE_ENV=development

# Sign-in is delegated to GitHub. Create an OAuth App at
# https://github.com/settings/developers with the Authorization callback URL set
# to <PUBLIC_API_URL>/api/auth/github/callback. Without these the app still
# boots, but the login routes report that sign-in is unconfigured.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Origin this API is reachable at; used to build the OAuth callback URL.
PUBLIC_API_URL=http://localhost:3001
# Where users land after signing in.
DEFAULT_RETURN_TO=http://localhost:3000
# Comma-separated origins allowed as post-sign-in redirect targets.
CORS_ORIGIN=http://localhost:3000
# SESSION_TTL_SEC=604800

# Bank credentials are encrypted with a per-user key. That key is wrapped by a
# key encryption key, which lives in Azure Key Vault when AZURE_KEY_VAULT_URL is
# set and is otherwise derived from ENCRYPTION_KEY. Set one or the other.
ENCRYPTION_KEY=your-secret-encryption-key-here
# AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net/
# AZURE_KEY_VAULT_KEY_NAME=credential-kek
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# DEK_CACHE_TTL_MS=900000

# Stock Price APIs (Optional - for automatic price updates)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Exchange Rate APIs (Optional - for currency conversion)
CURRENCY_API_KEY=your_currency_api_key_here
FIXER_API_KEY=your_fixer_api_key_here

# Redis (Required for the BullMQ scraping queue and distributed locks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
